COMPOSE_PROJECT_NAME=recruiting-ai
TZ=America/New_York

# n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=replace_with_a_32_plus_character_key
N8N_WEBHOOK_URL=http://localhost:5678/

# Local AI
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vector search
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=recruiting_memory
EMBEDDING_DIMENSION=768

# Search and scraping
SEARXNG_BASE_URL=http://searxng:8080
CRAWL4AI_BASE_URL=http://crawl4ai:11235
# Required when using Crawl4AI from other Docker services. Generate a long random value for .env.
CRAWL4AI_API_TOKEN=

# CRM
CRM_DB_PATH=/data/recruiting.db
CRM_SCHEMA_PATH=/app/database/schema.sql

# Gmail and SMTP secrets are configured in n8n credentials.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
NOTIFICATION_EMAIL=

# Optional contact discovery APIs. Leave blank unless you are authorized to use them.
HUNTER_API_KEY=
APOLLO_API_KEY=
ROCKETREACH_API_KEY=
